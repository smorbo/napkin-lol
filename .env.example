# Napkin environment variables. Copy this file to ".env" and fill in the
# values from your own Supabase project (Dashboard -> Settings -> API).
# Never commit a filled-in .env.

# Supabase project ref (e.g. abcdefghijklmnopqrst)
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=

# https://<your-project-ref>.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=

# Publishable (anon) key. Safe to expose in the browser; Row Level
# Security is what protects the data.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Service role key. SERVER ONLY — bypasses Row Level Security.
# Used by server code for room cleanup. Never ship this to a client.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer secret the expired-room cleanup endpoint checks.
# CRON_SECRET_PREVIOUS is optional and lets you rotate without downtime.
CRON_SECRET=
CRON_SECRET_PREVIOUS=
